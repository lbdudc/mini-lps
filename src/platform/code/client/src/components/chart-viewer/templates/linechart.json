{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Dynamic chart for selected entity",
  "width": {
    "signal": "max(800, length(data('dataset')) * 30)"
  },
  "height": 400,
  "padding": 5,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": [
    {
      "name": "dataset",
      "url": "###<= data.basicData.extra?.server_deploy_url || (feature.D_C_Nginx ? 'http://localhost/backend' : 'http://localhost:9001/backend') >###/api/entities/__ENTITY__/export/tsv",
      "format": {
        "type": "tsv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum['__XFIELD__'] != null && datum['__YFIELD__'] != null"
        },
        {
          "type": "collect",
          "sort": {
            "field": "__XFIELD__",
            "order": "ascending"
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "point",
      "domain": {
        "data": "dataset",
        "field": "__XFIELD__"
      },
      "range": "width",
      "padding": 0.5
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "dataset",
        "field": "__YFIELD__"
      },
      "range": "height",
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "__XFIELD__",
      "labelAngle": -45,
      "labelAlign": "right",
      "labelOverlap": "parity",
      "labelFontSize": 10,
      "tickCount": 20
    },
    {
      "orient": "left",
      "scale": "y",
      "title": "__YFIELD__",
      "format": "~s",
      "grid": true,
      "gridOpacity": 0.1
    }
  ],
  "marks": [
    {
      "type": "line",
      "from": {
        "data": "dataset"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "__XFIELD__"
          },
          "y": {
            "scale": "y",
            "field": "__YFIELD__"
          },
          "stroke": {
            "value": "steelblue"
          },
          "strokeWidth": {
            "value": 2
          },
          "strokeOpacity": {
            "value": 0.8
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "dataset"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "__XFIELD__"
          },
          "y": {
            "scale": "y",
            "field": "__YFIELD__"
          },
          "fill": {
            "value": "white"
          },
          "stroke": {
            "value": "steelblue"
          },
          "strokeWidth": {
            "value": 1
          },
          "size": {
            "value": 30
          },
          "tooltip": {
            "signal": "datum"
          }
        }
      }
    }
  ]
}