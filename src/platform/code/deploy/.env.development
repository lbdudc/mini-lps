/*% if (feature.MV_Processes) { %*/
PG_CONTAINER_NAME=lvm-postgres
POSTGRES_USER='lvm'
POSTGRES_PASSWORD='+lvm+'
POSTGRES_DB='lvm'
POSTGRES_MULTIPLE_EXTENSIONS='postgis,postgis_topology,postgis_raster,postgis_sfcgal,postgis_tiger_geocoder'
POSTGRES_RUN_AS_ROOT='true'
PGDATA='/data/postgres'

QGSWPS_SERVER_PARALLELPROCESSES=2
QGSWPS_GEOSERVER_URL='http://host.docker.internal:9001/geoserver' # CHANGE: Use your server deploy port
QGSWPS_SERVER_OWS_SERVICE_URL='http://localhost:8082/ows/'
QGSWPS_SERVER_PROXY_URL='http://localhost:8888'
QGSWPS_LOGLEVEL=DEBUG
QGSWPS_MODELS_PATH='../server/models'
QGSWPS_PROJECTS_PATH='../server/projects'
QGSWPS_USER=1000:1000
QGSWPS_DB_NAME='lvm'
QGSWPS_DB_HOST='172.19.0.1' # CHANGE: Your docker network gateway for connecting WPS container to Postgres
QGSWPS_DB_PORT='5432'
QGSWPS_DB_USER='postgres'
QGSWPS_DB_PASSWORD='postgres'

QGSRV_SERVER_PROXY_URL='http://localhost:8082'
QGSRV_LOGGING_LEVEL=DEBUG
QGSRV_SERVER_WORKERS=2

CESGA_DIR='../server/cesga'

/*% } %*/
